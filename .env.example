PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/pe_reporting_agent
JWT_SECRET=super_secret_pe_jwt_key_2026_dev_secure
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# AI / LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Or custom base URL if using local/alternative LLM:
# OPENAI_BASE_URL=https://api.openai.com/v1

# Security
CORS_ORIGIN=http://localhost:3000

